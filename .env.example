# OpenAI-compatible upstream; the proxy calls {UPSTREAM_BASE_URL}/chat/completions.
UPSTREAM_BASE_URL=https://api.openai.com/v1

# Leave empty to forward each client's own "Authorization: Bearer ..." header upstream.
UPSTREAM_API_KEY=

# Secret for HMAC-SHA256 hashing of vaulted plaintext. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
VAULT_HMAC_SECRET=change-me-in-prod-hmac-key

# SQLite vault location (WAL mode). docker-compose pins this to /data/vault.db.
DB_PATH=/data/vault.db

# true = answer from a built-in offline mock that echoes tokens split across chunks.
MOCK_UPSTREAM=false
