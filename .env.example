# OpenAI-compatible upstream; the proxy calls {UPSTREAM_OPENAI_URL}/chat/completions.
UPSTREAM_OPENAI_URL=https://api.openai.com/v1

# OpenAI route only. Leave empty to forward each client's own "Authorization: Bearer ..." header upstream.
UPSTREAM_API_KEY=

# Gemini API host for /v1beta/models/... requests (agy with GOOGLE_GEMINI_BASE_URL). The client's own
# x-goog-api-key / Authorization header is forwarded.
UPSTREAM_GEMINI_URL=https://generativelanguage.googleapis.com

# Code Assist backend for /v1internal:... requests (agy signed in with a Google account, CLOUD_CODE_URL).
UPSTREAM_CODE_ASSIST_URL=https://daily-cloudcode-pa.googleapis.com

# Comma-separated hostnames, domains, or names always replaced with <<CUSTOM_NN>>.
CUSTOM_REDACT_TERMS=

# Session to fall back to when hydrating a token the request's session doesn't know (e.g. "global").
VAULT_FALLBACK_SESSION=

# Secret for HMAC-SHA256 hashing of vaulted plaintext. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
VAULT_HMAC_SECRET=change-me-in-prod-hmac-key

# SQLite vault location (WAL mode). docker-compose pins this to /data/vault.db.
DB_PATH=/data/vault.db

# true = answer from a built-in offline mock that echoes tokens split across chunks.
MOCK_UPSTREAM=false

# Local NER for people, schools, and other unstructured entities.
# gliner = bundled GLiNER model (default in Docker); none = regex detectors only.
# Changing NER_BACKEND or NER_MODEL requires rebuilding the image (docker compose up -d --build).
NER_BACKEND=gliner
NER_MODEL=urchade/gliner_multi_pii-v1
# Comma-separated "model label:TOKEN_TYPE" pairs. Add e.g. "street address:ADDRESS" or "organization:ORG".
NER_LABELS=person:PERSON,school:SCHOOL,university:SCHOOL
# 0-1; lower catches more entities but also more false positives.
NER_THRESHOLD=0.5
# Comma-separated words the model should never redact (e.g. product names it mistakes for people).
NER_IGNORE=
